```{=html}
<%
  const areas = [
    { id: "forecasting", title: "Time series forecasting", icon: "graph-up", text: "Libraries and research code for point and probabilistic forecasting." },
    { id: "energy", title: "Energy systems and grid analytics", icon: "lightning-charge", text: "Network simulation, state estimation, clustering and anomaly detection for low-voltage grids and smart meter data." },
    { id: "nilm", title: "Non-intrusive load monitoring", icon: "plug", text: "Appliance recognition and state detection from aggregate measurements." },
    { id: "bayes", title: "Probabilistic and Bayesian modelling", icon: "bar-chart-steps", text: "Notebooks on Bayesian inference, probabilistic programming and model-based machine learning." },
    { id: "mle", title: "Machine learning engineering and teaching", icon: "diagram-3", text: "Project-based paths and course material for applied, production-ready machine learning." },
    { id: "strategy", title: "Technology strategy", icon: "compass", text: "Writing on AI strategy, technology roadmapping and business model innovation." }
  ];
  const statusIcon = { Active: "lightning-fill", Maintained: "shield-check", Community: "globe", Series: "journal-text" };
  const links = [
    ["pypi", "PyPI", "box-seam"], ["docs", "Documentation", "book"], ["site", "Website", "link-45deg"],
    ["github", "GitHub", "github"], ["post", "Read", "journal-text"], ["paper-url", "Paper", "file-earmark-text"]
  ];
  const groups = {};
  items.forEach((item) => { (groups[item.area] = groups[item.area] || []).push(item); });
%>
<div class="work-controls">
<nav class="work-areas" aria-label="Project areas">
  <a href="#" data-area="all" class="active">All</a>
<% areas.forEach((a) => { if (groups[a.id]) { %>
  <a href="#area-<%= a.id %>" data-area="<%= a.id %>"><i class="bi bi-<%= a.icon %>"></i><%= a.title %></a>
<% } }) %>
</nav>
<input type="search" class="work-search" placeholder="Search projects" aria-label="Search projects">
</div>
<p class="work-empty" hidden>No project matches the current filter.</p>
<% areas.forEach((a) => { const group = groups[a.id]; if (!group) return; %>
<section class="work-area" id="area-<%= a.id %>">
  <h2><i class="bi bi-<%= a.icon %>"></i><%= a.title %></h2>
  <p class="work-area-text"><%= a.text %></p>
  <div class="work-grid">
<% group.forEach((p) => { %>
    <article class="work-card">
      <div class="work-card-head">
        <h3><%= p.title %></h3>
        <span class="work-year"><%= p.year %></span>
      </div>
      <p class="work-description"><%= p.description %></p>
      <p class="work-meta"><i class="bi bi-<%= statusIcon[p.status] || 'star-fill' %>"></i><%= p.status %> <span>Updated <%= p.updated %></span></p>
      <div class="work-links">
<% links.forEach(([key, label, icon]) => { if (p[key]) { %>
        <a href="<%= p[key] %>" target="_blank" rel="noopener"><i class="bi bi-<%= icon %>"></i><%= label %></a>
<% } }) %>
      </div>
    </article>
<% }) %>
  </div>
</section>
<% }) %>
```
