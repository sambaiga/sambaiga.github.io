```{=html}
<%
  // A talk without a slide deck shows the default picture of the blog, as a post without a cover does.
  const FALLBACK = "../../images/blogs/arts.jpg";
  const TYPES = {
    conference: { label: "Conference", icon: "people" },
    invited: { label: "Invited", icon: "mic" },
    teaching: { label: "Teaching", icon: "mortarboard" },
    poster: { label: "Poster", icon: "file-earmark-richtext" }
  };
  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const when = (t) => (t.month ? MONTHS[t.month - 1] + " " : "") + t.year;
  const iso = (t) => t.year + (t.month ? "-" + String(t.month).padStart(2, "0") : "");
  const meta = (t) => TYPES[t.type] || TYPES.conference;
  const href = (t) => t.slides || t.link || "";

  const sorted = items.slice().sort((a, b) => b.year * 100 + (b.month || 0) - (a.year * 100 + (a.month || 0)));
  const years = [...new Set(sorted.map((t) => t.year))];
  const typeCounts = {};
  const topicCounts = {};
  items.forEach((t) => {
    typeCounts[t.type] = (typeCounts[t.type] || 0) + 1;
    topicCounts[t.topic] = (topicCounts[t.topic] || 0) + 1;
  });
  const topics = Object.keys(topicCounts).sort();
  const latest = sorted.find((t) => t.slides);
%>
<div class="tk">

<h1 class="ls-title">Talks</h1>
<p class="tk-stats"><%= items.length %> talks
<% Object.keys(TYPES).filter((k) => typeCounts[k]).forEach((k) => { %><span>·</span> <%= typeCounts[k] %> <%= TYPES[k].label.toLowerCase() %> <% }) %></p>

<% if (latest) { %>
<section class="tk-panel" aria-labelledby="tk-latest">
  <p class="tk-kicker" id="tk-latest">Latest talk</p>
  <article class="tk-feature">
    <a class="tk-thumb tk-deck" href="<%= latest.slides %>" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <img src="<%= latest.thumb || FALLBACK %>" alt="" width="560" height="420" fetchpriority="high" decoding="async">
    </a>
    <div class="tk-feature-body">
      <p class="tk-type"><span class="tk-kind"><i class="bi bi-<%= meta(latest).icon %>"></i><b><%= meta(latest).label %></b><span><%= latest.topic %></span></span><time datetime="<%= iso(latest) %>"><%= when(latest) %></time></p>
      <h2 class="no-anchor"><a href="<%= latest.slides %>" target="_blank" rel="noopener"><%= latest.title %></a></h2>
      <p class="tk-meta">
        <span><i class="bi bi-building"></i><%= latest.venue %></span>
<% if (latest.place) { %>        <span><i class="bi bi-geo-alt"></i><%= latest.place %></span>
<% } %><% if (latest.coauthors) { %>        <span><i class="bi bi-people"></i><%= latest.coauthors %></span>
<% } %>      </p>
      <div class="tk-actions">
        <a class="ls-button" href="<%= latest.slides %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i>View the slides</a>
<% if (latest.video) { %>        <a class="tk-button" href="<%= latest.video %>" target="_blank" rel="noopener"><i class="bi bi-play-circle"></i>Video</a>
<% } %><% if (latest.link) { %>        <a class="tk-button" href="<%= latest.link %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i>Event</a>
<% } %>      </div>
    </div>
  </article>
</section>
<% } %>

<div class="tk-controls">
  <nav class="ls-chips" aria-label="Talk types">
    <a href="#" data-chip="all" class="active">All <span><%= items.length %></span></a>
<% Object.keys(TYPES).filter((k) => typeCounts[k]).forEach((k) => { %>
    <a href="#" data-chip="<%= k %>"><i class="bi bi-<%= TYPES[k].icon %>"></i><%= TYPES[k].label %> <span><%= typeCounts[k] %></span></a>
<% }) %>
  </nav>
  <select class="tk-select" data-topic-select aria-label="Topic">
    <option value="all">All topics</option>
<% topics.forEach((topic) => { %>
    <option value="<%= topic %>"><%= topic %> (<%= topicCounts[topic] %>)</option>
<% }) %>
  </select>
  <input type="search" class="ls-search" data-search placeholder="Search talks" aria-label="Search talks">
</div>
<p class="tk-status" aria-live="polite"><span data-status></span> <button type="button" class="tk-clear" data-clear hidden><i class="bi bi-x-circle"></i>Clear filters</button></p>
<p class="ls-empty" data-empty hidden>No talk matches the current filters.</p>

<div data-list>
<% years.forEach((year) => { %>
<section class="tk-year" data-group aria-label="<%= year %>">
  <h2 class="no-anchor"><%= year %> <span data-count><%= sorted.filter((t) => t.year === year).length %></span></h2>
  <div class="tk-cards">
<% sorted.filter((t) => t.year === year).forEach((t) => { %>
    <article class="tk-card" data-item data-type="<%= t.type %>" data-topic="<%= t.topic %>">
      <a class="tk-thumb<%= t.thumb ? '' : ' tk-thumb--default' %>"<% if (href(t)) { %> href="<%= href(t) %>" target="_blank" rel="noopener"<% } %> tabindex="-1" aria-hidden="true">
        <img src="<%= t.thumb || FALLBACK %>" alt="" width="280" height="210" loading="lazy" decoding="async">
      </a>
      <div class="tk-body">
        <div class="tk-top">
          <span class="tk-kind"><i class="bi bi-<%= meta(t).icon %>"></i><b><%= meta(t).label %></b><span><%= t.topic %></span></span>
          <time datetime="<%= iso(t) %>"><%= when(t) %></time>
        </div>
        <h3 class="no-anchor"><% if (href(t)) { %><a href="<%= href(t) %>" target="_blank" rel="noopener"><span class="tk-clamp"><%= t.title %></span></a><% } else { %><span class="tk-clamp"><%= t.title %></span><% } %></h3>
        <p class="tk-meta">
          <span><i class="bi bi-building"></i><%= t.venue %></span>
<% if (t.place) { %>          <span class="tk-opt"><i class="bi bi-geo-alt"></i><%= t.place %></span>
<% } %><% if (t.coauthors) { %>          <span class="tk-opt"><i class="bi bi-people"></i><%= t.coauthors %></span>
<% } %>        </p>
<% if (t.slides || t.video || t.link || t.pages) { %>
        <div class="tk-foot">
          <span><%= t.pages || "" %></span>
          <div class="tk-actions">
<% if (t.slides) { %>            <a class="tk-link tk-link--main" href="<%= t.slides %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i>Slides</a>
<% } %><% if (t.video) { %>            <a class="tk-link<%= t.slides ? '' : ' tk-link--main' %>" href="<%= t.video %>" target="_blank" rel="noopener"><i class="bi bi-play-circle"></i>Video</a>
<% } else if (t.link && !t.slides) { %>            <a class="tk-link tk-link--main" href="<%= t.link %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i>Event</a>
<% } %>          </div>
        </div>
<% } %>
      </div>
    </article>
<% }) %>
  </div>
</section>
<% }) %>
</div>

<nav class="tk-pager" data-pager aria-label="Pagination" hidden></nav>
<p class="tk-pager-info" data-pager-info></p>

<p class="tk-note"><i class="bi bi-info-circle" aria-hidden="true"></i>Slides are shared under CC BY 4.0, like the rest of the site.</p>

</div>
```
