```{=html}
<%
  const tagsOf = (book) => (Array.isArray(book.tags) ? book.tags : []);
  const shelves = [...new Set(items.map((b) => b.shelf))];
  const genres = [...new Set(items.map((b) => b.genre))];
  const counts = {};
  items.forEach((b) => { counts[b.genre] = (counts[b.genre] || 0) + 1; });
  const showControls = items.length > 6;
%>
<% if (showControls) { %>
<div class="tl-controls">
<nav class="tl-areas" aria-label="Book topics">
  <a href="#" data-area="all" class="active">All <span><%= items.length %></span></a>
<% genres.forEach((g) => { %>
  <a href="#" data-area="<%= g %>"><%= g %> <span><%= counts[g] %></span></a>
<% }) %>
</nav>
<input type="search" class="tl-search" placeholder="Search books" aria-label="Search books">
</div>
<p class="tl-empty" hidden>No book matches the current filter.</p>
<% } %>
<div class="tl">
<% shelves.forEach((shelf) => { %>
  <section class="tl-year">
    <div class="tl-year-label"><%= shelf %></div>
    <div class="tl-items">
<% items.filter((book) => book.shelf === shelf).forEach((book) => { %>
      <article class="tl-item tl-book" data-area="<%= book.genre %>">
        <a class="tl-cover tl-cover--<%= book.variant %>" href="<%= book.url %>" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
<% if (book.cover) { %>
          <img src="<%= book.cover %>" alt="" loading="lazy" width="88" height="132">
<% } else { %>
          <i class="bi bi-<%= book.icon %>"></i>
<% } %>
        </a>
        <div class="tl-book-body">
          <div class="tl-head">
            <h2><a href="<%= book.url %>" target="_blank" rel="noopener"><%= book.title %></a></h2>
            <span class="tl-area"><%= book.year %></span>
          </div>
          <p class="tl-subtitle"><%= book.subtitle %></p>
          <p class="tl-description"><%= book.description %></p>
          <div class="tl-tags">
<% tagsOf(book).forEach((tag) => { %>
            <span><%= tag %></span>
<% }) %>
          </div>
          <div class="tl-foot">
            <p class="tl-meta"><span class="ls-pill ls-pill--<%= book.status %>"><i class="bi bi-<%= book.status_icon %>"></i><%= book.status_label %></span><% if (book.chapters) { %><span><%= book.chapters %></span><% } %></p>
            <div class="tl-links">
<% if (book.page) { %>
              <a href="<%= book.page %>"><i class="bi bi-info-circle"></i>About the book</a>
<% } %>
              <a href="<%= book.url %>" target="_blank" rel="noopener"><i class="bi bi-book-half"></i>Read online</a>
            </div>
          </div>
        </div>
      </article>
<% }) %>
    </div>
  </section>
<% }) %>
</div>
```
