```{=html}
<%
  const compact = items.length > 6;
  const genres = [...new Set(items.map((b) => b.genre))];
  const counts = {};
  items.forEach((b) => { counts[b.genre] = (counts[b.genre] || 0) + 1; });
%>
<% if (compact) { %>
<div class="bk-controls">
<nav class="bk-genres" aria-label="Book topics">
  <a href="#" data-genre="all" class="active">All <span><%= items.length %></span></a>
<% genres.forEach((g) => { %>
  <a href="#" data-genre="<%= g %>"><%= g %> <span><%= counts[g] %></span></a>
<% }) %>
</nav>
<input type="search" class="bk-search" placeholder="Search books" aria-label="Search books">
</div>
<p class="bk-empty" hidden>No book matches the current filter.</p>
<% } %>
<div class="bk-list<%= compact ? ' bk-list--compact' : '' %>">
<% items.forEach((book) => { %>
<article class="bk bk--<%= book.variant %>" data-genre="<%= book.genre %>">
  <div class="bk-cover"><i class="bi bi-<%= book.icon %>"></i></div>
  <div class="bk-body">
    <div class="bk-top">
      <h3><%= book.title %></h3>
      <span class="bk-year"><%= book.year %></span>
    </div>
    <p class="bk-subtitle"><%= book.subtitle %></p>
    <p class="bk-description"><%= book.description %></p>
    <div class="bk-tags">
<% (Array.isArray(book.tags) ? book.tags : []).forEach((tag) => { %>
      <span><%= tag %></span>
<% }) %>
    </div>
    <div class="bk-foot">
      <p class="bk-meta"><i class="bi bi-<%= book.status_icon %>"></i><%= book.status_label %><span><%= book.chapters %></span></p>
      <a href="<%= book.url %>" class="bk-link" target="_blank" rel="noopener"><i class="bi bi-book-half"></i>Read online</a>
    </div>
  </div>
</article>
<% }) %>
</div>
```
